      return composed || `오늘은 ${dateStr}입니다${/요일/.test(text) ? ` ${weekday}입니다.` : '.'}`;
    }
    if (/(내일|모레|다음\s*주|이번\s*주)/.test(text) && /(며칠|날짜|요일)/.test(text)) {
      const nowApi = await fetchKSTNowFromAPI();
